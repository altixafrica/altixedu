# Production Environment Variables
# 
# IMPORTANT: Update VITE_API_URL with your Render backend URL
# Example: https://altixedu-api.onrender.com
#
# Set in Vercel Environment Variables:
# 1. Go to Vercel dashboard → Project Settings → Environment Variables
# 2. Add each variable below
# 3. Redeploy after updating

# Backend API URL (REQUIRED - update with your Render URL)
VITE_API_URL=https://<your-render-app>.onrender.com

# API request timeout (milliseconds)
VITE_API_TIMEOUT=10000

# Retry failed requests
VITE_RETRY_ATTEMPTS=3
VITE_RETRY_DELAY=500

# Environment mode
VITE_ENVIRONMENT=production

# Disable console logs in production
VITE_ENABLE_CONSOLE_LOGS=false

# Enable error reporting to Sentry (optional)
VITE_ENABLE_ERROR_REPORTING=true

# App version (update with each release)
VITE_APP_VERSION=1.0.0

