# Django Settings
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=your-secure-secret-key-here-generate-with-python
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.altixedu.com
DJANGO_DB_ENGINE=django.db.backends.postgresql
DJANGO_DB_NAME=altixedu_db
DJANGO_DB_USER=altixedu_user
DJANGO_DB_PASSWORD=your-secure-db-password
DJANGO_DB_HOST=localhost
DJANGO_DB_PORT=5432

# Security
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_COOKIES=True
ENCRYPTION_KEY=your-fernet-encryption-key

# CORS Configuration
DJANGO_CORS_ALLOWED_ORIGINS=https://app.altixedu.com,https://dashboard.altixedu.com

# Frontend
FRONTEND_APP_URL=https://app.altixedu.com

# Flutterwave Billing
FLUTTERWAVE_BASE_URL=https://api.flutterwave.com/v3
FLUTTERWAVE_SECRET_KEY=your-flutterwave-secret-key
FLUTTERWAVE_PUBLIC_KEY=your-flutterwave-public-key
FLUTTERWAVE_SECRET_HASH=your-flutterwave-webhook-secret

# Internationalization
DJANGO_LANGUAGE_CODE=en-us
DJANGO_TIME_ZONE=UTC
