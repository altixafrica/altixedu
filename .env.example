################################################################################
# ALTIXEDU PRODUCTION ENVIRONMENT CONFIGURATION
# 
# This file contains all environment variables needed for production deployment.
# NEVER commit the actual .env file to Git - use .env.example as template only.
#
# For Render/Railway deployment: Add these vars in platform's secrets panel
# For local development: Copy to .env and update with local values
################################################################################

# ==============================================================================
# 1. DJANGO CORE SETTINGS (REQUIRED)
# ==============================================================================

# Security: Set to False only for local development
DJANGO_DEBUG=False

# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=your-secure-secret-key-here-generate-with-python

# Comma-separated list of allowed domains (include subdomains)
# For production: include your main domain
# Example: DJANGO_ALLOWED_HOSTS=altixedu.com,*.altixedu.com,app.altixedu.com,api.altixedu.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.altixedu.com,*.render.com,*.onrender.com

# Language and timezone
DJANGO_LANGUAGE_CODE=en-us
DJANGO_TIME_ZONE=Africa/Lagos

# ==============================================================================
# 2. DATABASE CONFIGURATION - SUPABASE PostgreSQL (PRODUCTION RECOMMENDED)
# ==============================================================================
# 
# Database URL format (preferred for Render/Railway):
# PostgreSQL connection string from Supabase dashboard
# Settings → Database → Connection string → URI
# Example: postgresql://postgres:PASSWORD@db.xxxxx.supabase.co:5432/postgres

# Traditional setup (alternative):
DJANGO_DB_ENGINE=django.db.backends.postgresql
DJANGO_DB_NAME=postgres
DJANGO_DB_USER=postgres.xxxxxxxxxxxxx
DJANGO_DB_PASSWORD=your-secure-password-from-supabase
DJANGO_DB_HOST=db.xxxxx.supabase.co
DJANGO_DB_PORT=5432

# For local SQLite development (optional, comment out above for prod):
# DJANGO_DB_ENGINE=django.db.backends.sqlite3
# DJANGO_DB_NAME=db.sqlite3

# ==============================================================================
# 3. SECURITY SETTINGS (PRODUCTION CRITICAL)
# ==============================================================================

# Force HTTPS in production (set True for production)
DJANGO_SECURE_SSL_REDIRECT=True

# Secure cookies (httponly, secure, samesite)
DJANGO_SECURE_COOKIES=True

# Fernet encryption key for sensitive data
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-fernet-encryption-key-generate-command-above

# ==============================================================================
# 4. CORS & FRONTEND CONFIGURATION (REQUIRED FOR FRONTEND INTEGRATION)
# ==============================================================================

# Comma-separated list of allowed frontend origins
# For production with Vercel:
# DJANGO_CORS_ALLOWED_ORIGINS=https://altixedu.vercel.app,https://app.altixedu.com,https://dashboard.altixedu.com
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://app.altixedu.com,https://dashboard.altixedu.com

# Frontend application URL (used in emails, redirects)
FRONTEND_APP_URL=https://app.altixedu.com

# ==============================================================================
# 5. EMAIL CONFIGURATION - CHOOSE ONE PROVIDER (REQUIRED FOR PRODUCTION)
# ==============================================================================
#
# AltixEdu sends emails for: password reset, enrollment confirmations, 
# student performance alerts, finance notifications, etc.
#
# Recommended for Africa (most cost-effective):
# - Mailgun: $0.50/1000 emails, global, reliable
# - Resend: Free tier (50/day), great for startups
# - Afrika's Talking: Best for bulk African operations
#

# OPTION A: MAILGUN (Recommended - global coverage)
# Free tier: 1000 emails/month
# Setup: https://www.mailgun.com → Create account → API Keys
EMAIL_PROVIDER=mailgun
MAILGUN_API_KEY=key-xxxxxxxxxxxxxxxxxxxxxxxx
MAILGUN_DOMAIN=mg.your-domain.com
MAILGUN_SENDER_EMAIL=noreply@altixedu.com

# OPTION B: RESEND (Best for startups)
# Free tier: 50 emails/day, perfect for MVP
# Setup: https://resend.com → Sign up → API Keys
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_xxxxxxxxxxxxx
# RESEND_SENDER_EMAIL=noreply@altixedu.com

# OPTION C: SMTP (Gmail, SendGrid, etc.)
# Most flexible, can use any SMTP provider
# Setup: Generate app password if using Gmail
# EMAIL_PROVIDER=smtp
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
# DEFAULT_FROM_EMAIL=noreply@altixedu.com

# ==============================================================================
# 6. SMS CONFIGURATION - CHOOSE ONE PROVIDER (REQUIRED FOR NOTIFICATIONS)
# ==============================================================================
#
# AltixEdu sends SMS for: attendance alerts, fee payment reminders,
# emergency announcements, two-factor authentication codes
#
# Recommended for Africa (cheapest options):
# - Afrika's Talking: $0.05-0.15/SMS, African focused
# - Termii: $0.01-0.05/SMS, Nigeria & West Africa specialist
# - AWS SNS: $0.00645/SMS globally, reliable
#

# OPTION A: AFRICA'S TALKING (Best for Africa coverage)
# Free tier: 100 SMS + $2 credit
# Setup: https://africastalking.com → Create account → API Keys
SMS_PROVIDER=africas_talking
AFRICAS_TALKING_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AFRICAS_TALKING_USERNAME=your_username
AFRICAS_TALKING_SENDER_ID=AltixEdu

# OPTION B: TERMII (Cheapest in Nigeria/West Africa)
# Free tier: 100 SMS
# Setup: https://www.termii.com → Sign up → API Keys
# SMS_PROVIDER=termii
# TERMII_API_KEY=xxxxxxxxxxxxxxxxx
# TERMII_SENDER_ID=AltixEdu

# OPTION C: AWS SNS (Most reliable globally)
# Pay-as-you-go: ~$0.00645/SMS
# Setup: AWS Console → SNS → Create account
# SMS_PROVIDER=aws_sns
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=xxxxx
# AWS_SECRET_ACCESS_KEY=xxxxx
# AWS_SNS_SENDER_ID=AltixEdu

# ==============================================================================
# 7. NOTIFICATION & CELERY CONFIGURATION (ASYNC TASK PROCESSING)
# ==============================================================================
#
# Celery handles background jobs: sending emails, SMS, generating reports
# Redis acts as message broker (faster than RabbitMQ for small deployments)
#
# For production on Render/Railway:
# Add Redis add-on in platform dashboard, get URL from settings
#

# Notification behavior
AUTO_SEND_ANNOUNCEMENTS=True
AUTO_SEND_MESSAGE_NOTIFICATIONS=True

# Redis connection (used by Celery + Django caching)
# Local: redis://localhost:6379/0
# Cloud: Get from Render/Railway Redis add-on
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# ==============================================================================
# 8. PAYMENT GATEWAY CONFIGURATION - FLUTTERWAVE
# ==============================================================================
#
# Flutterwave handles school subscription billing, student fee payments,
# supports African payment methods (mobile money, bank transfers, cards)
#
# Setup: https://dashboard.flutterwave.com → Create account → API Keys
#

FLUTTERWAVE_BASE_URL=https://api.flutterwave.com/v3
FLUTTERWAVE_SECRET_KEY=your-flutterwave-secret-key
FLUTTERWAVE_PUBLIC_KEY=your-flutterwave-public-key
FLUTTERWAVE_SECRET_HASH=your-flutterwave-webhook-secret

# ==============================================================================
# 9. OPTIONAL: FILE STORAGE & CDN (AWS S3 for production)
# ==============================================================================
#
# For storing student photos, documents, certificates securely
# Local development uses filesystem, production uses S3
#

# AWS_STORAGE_BUCKET_NAME=altixedu-production
# AWS_S3_REGION_NAME=us-east-1
# AWS_ACCESS_KEY_ID=xxxxx
# AWS_SECRET_ACCESS_KEY=xxxxx
# AWS_S3_CUSTOM_DOMAIN=cdn.altixedu.com

# ==============================================================================
# 10. LOGGING & MONITORING (Optional but recommended)
# ==============================================================================

# Sentry error tracking: https://sentry.io
# SENTRY_DSN=https://xxxxx@xxxxx.ingest.sentry.io/xxxxx

# Application environment
APP_ENVIRONMENT=production

# ==============================================================================
# DEPLOYMENT QUICK REFERENCE
# ==============================================================================
#
# FOR RENDER.COM:
# 1. Create new Web Service from GitHub
# 2. Environment Variables section:
#    - Paste all DJANGO_* vars from this file
#    - Add DATABASE_URL (from Supabase)
#    - Add REDIS_URL (from Render Redis add-on)
#    - Add MAILGUN_API_KEY, AFRICAS_TALKING_API_KEY, FLUTTERWAVE_SECRET_KEY
# 3. Build command: pip install -r requirements.txt
# 4. Start command: gunicorn altixedu.wsgi:application
# 5. Deploy!
#
# FOR VERCEL FRONTEND:
# 1. Connect GitHub repo
# 2. Environment Variables:
#    - VITE_API_URL=https://your-render-api.onrender.com
# 3. Deploy!
#
# FOR LOCAL DEVELOPMENT:
# 1. Copy .env.example to .env
# 2. Update with your local values:
#    - DJANGO_DEBUG=True
#    - DJANGO_DB_ENGINE=django.db.backends.sqlite3
#    - REDIS_URL=redis://localhost:6379/0 (if using Redis)
# 3. python manage.py migrate
# 4. python manage.py runserver
#

